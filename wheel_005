class wheel_class(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        self.base_surf, self.base_rect = wheel_create("text")
        self.x = 0
        self.n = 300
        self.spinning = False
        self.result = False ##
        self.image = self.base_surf
        self.rect = self.base_surf.get_rect(center = (screen.get_width()/2,screen.get_height()/2))

    def spin(self):
        self.image = pygame.transform.rotate(self.base_surf, self.x)
        self.rect = self.image.get_rect(center=(screen.get_width()/2,screen.get_height()/2))
        self.x += (random.uniform(1, 1.1) * self.n / 100)
        self.x %= 360
        self.n -= 1

        if self.n <= 0:            
            for i in range(len(state.dic)):
                if state.dic[i]['start'] <= (90 - self.x) % 360 < state.dic[i]['end']:
                    print(state.dic[i]['type'])
                    
            self.n = 300
            self.spinning = False
            self.result = True

    def surface_update(self):
        self.base_surf, self.base_rect = wheel_create("text")
        self.image = self.base_surf
        self.rect = self.image.get_rect(center = (screen.get_width()/2, screen.get_height()/2))
    
    def button_press(self):
        if pygame.mouse.get_pressed() == (1,0,0):
            mouse_pos = pygame.mouse.get_pos()
            if self.rect.collidepoint(mouse_pos) and not self.spinning:
                self.result = False
                self.spinning = True


    def update(self):
        self.button_press()
        if self.spinning and self.n > 0:
            self.spin()

