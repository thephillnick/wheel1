            part["i"] = n
            n += 1
        k+=1
        if k%3 == 0:
            rows.append(part)
            part = {}
    input_group.empty()

    for partje in rows:
        row_i = partje["i"]
        text_val = partje.get("text", "")
        num_val = partje.get("number", "1")

        input_group.add(input_class(row_i, text_val, False, "text"))
        input_group.add(input_class(row_i, num_val, False, "ratio"))
