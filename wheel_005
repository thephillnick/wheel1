input_types = ["text","ratio","remove"]

class input_class(pygame.sprite.Sprite):
    def __init__(self, i, textje, typing_check, type):
        super().__init__()
        self.type = type
        self.typing = typing_check
        self.i = i
        self.xtext = 400
        self.xrat = 50
        self.y = 35
        if self.type == "text":
            scale = (self.xtext,self.y)
        elif self.type == "ratio":
            scale = (self.xrat,self.y)
        elif self.type == "remove":
            scale = (self.y,self.y)
        base_surf = pygame.transform.smoothscale(trans_surf, scale)
        base_rect = base_surf.get_rect(topleft = (0,0))
        base_surf.fill("white", base_rect)

        if self.type != "remove":
            self.text = textje

            input_font = pygame.font.Font(None, 35)
            text_surf = input_font.render(self.text, False, "black")
            if self.type == "text":
                text_rect = text_surf.get_rect(midleft = (10, self.y/2))
            if self.type == "ratio":
                text_rect = text_surf.get_rect(center = (self.xrat/2, self.y/2))
            base_surf.blit(text_surf, text_rect)

        else:
            x = self.y
            y = self.y
            pygame.draw.rect(base_surf, "black", base_rect, 2)
            pygame.draw.line(base_surf, "black", (x - 10, y - 10), (10,10) , 3)
            pygame.draw.line(base_surf, "black", (10, y - 10), (x - 10,10), 3)
        pygame.draw.rect(base_surf, "black", base_rect, 2)

        self.image = base_surf
        if self.type == "text":
            self.rect = self.image.get_rect(topleft = (screen.get_width() - self.xtext - 10 - self.y, 200 + self.y*i))
        elif self.type == "ratio":
            self.rect = self.image.get_rect(topleft = (screen.get_width() - self.xtext - self.xrat - 10 - self.y , 200 + self.y*i))
        elif self.type == "remove":
            self.rect = self.image.get_rect(topleft = (screen.get_width() - 10 - self.y , 200 + self.y*i))


    def button_press(self):
        if pygame.mouse.get_pressed() == (1,0,0):
            mouse_pos = pygame.mouse.get_pos()
            if self.rect.collidepoint(mouse_pos) and not state.mousepressed:
                if self.type == "remove":
                    for box in input_group:
                        if box.i == self.i:
                            box.kill()
                    state.mousepressed = True 
                    rebuild_input()
                           
                else:
                    self.typing = True

            else:
                self.typing = False

        else:
            state.mousepressed = False

    def text_input(self, event):
        if self.typing and event.type == pygame.KEYDOWN:
            if event.key == pygame.K_BACKSPACE and self.text != "":
                self.text = self.text[:-1]
            elif event.key == pygame.K_RETURN:
                self.typing = False
            elif event.unicode:
                if self.type == "text":
                    self.text += event.unicode
                if self.type == "ratio" and event.unicode.isdigit():
                    self.text += event.unicode

                
            
            input_group.add(input_class(self.i, self.text, self.typing, self.type))
            self.kill()


    def update(self):
        self.button_press()

