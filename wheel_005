def angle_creation(weight_total):
    for i in range (len(state.dic)):
        state.dic[i]['slice'] = int(round(state.dic[i]['weight']/weight_total * 360))
        if i > 0:
            state.dic[i]['start'] = state.dic[i-1]['end']
        else:
            state.dic[i]['start'] = 0
        state.dic[i]['end'] = state.dic[i]['start'] + state.dic[i]['slice']

def wheel_create(type):
    amount = len(state.dic)
    weight_total = 0
    for i in range(len(state.dic)):
        weight_total += state.dic[i]["weight"]
