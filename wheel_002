dic = {}

dic[0] = {"weight": 8,
          "value": "rare",
          "type": "elite"}
for i in range (7):
    dic[i+1] = {"weight": 10,
                "value": "common",
                "type": "elite"}


def angle_creation(weight_total):
    for i in range (len(dic)):
        dic[i]['slice'] = int(round(dic[i]['weight']/weight_total * 360))
        if i > 0:
            dic[i]['start'] = dic[i-1]['end']
        else:
            dic[i]['start'] = 0
        dic[i]['end'] = dic[i]['start'] + dic[i]['slice']
 

def wheel_create():
    amount = len(dic)
    weight_total = 0
    for i in range(len(dic)):
        weight_total += dic[i]["weight"]
    angle_creation(weight_total)
    base_surf = pygame.transform.smoothscale(trans_surf, (2*r, 2*r))
    x_center = base_surf.get_width()/2
    y_center = base_surf.get_height()/2
    center = (x_center, y_center)
    
    pygame.draw.circle(base_surf, "black", center, r, 20)
    base_rect = base_surf.get_rect(center = (540,540))

    for i in range (amount):
        if dic[i]['value'] == "rare": colour = "gray"
        elif i%2 == 0: colour = "green"
        else: colour = "yellow"
        angle = dic[i]['start'] / 360 * 2 * math.pi
        for j in range(dic[i]['start'], dic[i]['end']):
            ang = j * 2 * math.pi / 360
            pygame.draw.line(base_surf, colour, center, (x_center + (r-8) * math.cos(ang), y_center - (r-8) * math.sin(ang)), 10)
    
        pygame.draw.line(base_surf, "black", center, (x_center + (r-8) * math.cos(angle), y_center - (r-8) * math.sin(angle)), 10)


    pygame.draw.line(base_surf, "black", center, (x_center + (r-8) * math.cos(0), y_center - (r-8) * math.sin(0)), 10)
    pygame.draw.circle(base_surf, "black", center, r, 20)

    base_surf, base_rect = add_images(base_surf,base_rect, x_center, y_center)
    return base_surf, base_rect


    #---------------------image adding------------
def add_images(base_surf, base_rect, x_center, y_center):
    r = 200
    for i in range (len(dic)):
        if dic[i]['type'] == "combat":
            surface = combat_surf.copy()
        if dic[i]['type'] == "elite":
            surface = elite_surf.copy()

        degree = (dic[i]['start'] + dic[i]['end']) / 2
        angle = degree / 180 * math.pi
        rotated_surf = pygame.transform.rotate(surface, degree - 90)
        rotated_rect = rotated_surf.get_rect(center = (x_center + r * math.cos(angle), y_center - r * math.sin(angle)))
        base_surf.blit(rotated_surf,rotated_rect)

    return base_surf, base_rect

  

base_surf, base_rect = wheel_create()


class wheel_class(pygame.sprite.Sprite):
    def __init__(self):
        self.x = 0
        self.n = 300
        self.spinning = False
        super().__init__()
        self.image = base_surf
        self.rect = base_surf.get_rect(center = (500,500))

    def spin(self):
        self.image = pygame.transform.rotate(base_surf, self.x)
        self.rect = self.image.get_rect(center = (500,500))
        self.x += (random.uniform(1,1.1) * self.n /10)%360
        self.n -= 1
    
    def button_press(self):
        if pygame.mouse.get_pressed() == (1,0,0):
            mouse_pos = pygame.mouse.get_pos()
            if self.rect.collidepoint(mouse_pos) and not self.spinning:
                self.spinning = True

    def update(self):
        self.button_press()
        if self.spinning and self.n > 0:
            self.spin()

        if self.n == 0:
            self.n = 300
            self.spinning = False


wheel_group = pygame.sprite.Group()
wheel_group.add(wheel_class())


while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    background("wood", (1920,1080))
    wheel_group.draw(screen)
    wheel_group.update()
    pygame.display.update()
    clock.tick(60)
