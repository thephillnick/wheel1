    y = screen.get_height() / 2
    if type == "wood":
        surface = wood_surf
    if type == "map":
        surface = paper_surf
    if type == "battle":
        surface = battle_surf
    if type == "card":
        surface = card_surf
    if type == "shelf":
        surface = shelf_surf
    resised_surface = pygame.transform.smoothscale(surface, scale)
    resised_rect = resised_surface.get_rect(center = (x,y))
